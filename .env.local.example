# ============================================================================
# Samorah — LOCAL DEVELOPMENT environment template
# ============================================================================
# Copy to `.env.local` and fill in:   cp .env.local.example .env.local
# `.env.local` is gitignored — NEVER commit real secrets.
#
# This template targets LOCAL development against local Docker Supabase and
# Razorpay TEST mode. Production and Preview values are set in Vercel, NOT here.
# See docs/deployment/ENVIRONMENT_VARIABLES or docs/DEPLOYMENT_ENV.md for the
# full matrix (which var in local vs Vercel Production vs Vercel Preview).
#
# Golden rule:
#   • LOCAL  → local Supabase + Razorpay TEST + synthetic data (this file).
#   • PROD   → hosted Supabase (Mumbai) + Razorpay LIVE   (Vercel → Production).
#   • PREVIEW→ safe test config, NO production service-role key, Razorpay TEST
#              (Vercel → Preview). Never point Preview at live payments/stock.
# ============================================================================

# ── Supabase (LOCAL) ─────────────────────────────────────────────────────────
# Start local Supabase first:  npm run db:start   (then: npm run db:reset to seed)
# Then run `npm run db:status` and copy the two keys it prints:
#   • "Publishable"/anon key  → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   • "Secret"/service_role   → SUPABASE_SERVICE_ROLE_KEY   (LOCAL secret only!)
# The URL below is the fixed local API port from supabase/config.toml.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudinary (image CDN) ────────────────────────────────────────────────────
# cloud_name is public. API key/secret are only needed for admin media UPLOADS;
# browsing the storefront works without them.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: asset folder namespace (defaults to "samorah").
# CLOUDINARY_FOLDER=samorah

# ── Razorpay (payments) — use TEST keys locally ───────────────────────────────
# key_id is public (client opens Checkout) → must be NEXT_PUBLIC_.
# Get TEST keys from Razorpay Dashboard → Settings → API Keys (Test Mode).
# NEVER put LIVE keys in this file — live keys belong only in Vercel Production.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Webhook signing secret (Razorpay → Webhooks). For local webhook testing use a
# tunnel (e.g. ngrok) + a TEST webhook; otherwise leave blank and rely on /verify.
RAZORPAY_WEBHOOK_SECRET=
# Optional: our Razorpay account id ("acc_XXXX") → webhook merchant guard.
RAZORPAY_ACCOUNT_ID=

# ── App secrets (generate your own random values for local) ───────────────────
# These are dev-only values; production uses dedicated random secrets in Vercel.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORDER_TOKEN_SECRET=local-dev-order-token-secret-change-me
CRON_SECRET=local-dev-cron-secret-change-me
IP_HASH_SALT=local-dev-ip-hash-salt-change-me

# ── App URLs ──────────────────────────────────────────────────────────────────
# Local only — ignored when NODE_ENV=production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Canonical domain for SEO/OG/sitemap (prod sets the real domain in Vercel).
# NEXT_PUBLIC_SITE_DOMAIN=samorahstudio.com

# ── Email (optional locally) — provider-agnostic; Resend in prod ──────────────
# Leave RESEND_API_KEY blank locally: outbound email is captured by Mailpit at
# http://127.0.0.1:54324 when running local Supabase, so no real send happens.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Samorah <hello@samorahstudio.com>"
EMAIL_REPLY_TO=hello@samorahstudio.com

# ── Shipping (optional) — Shiprocket; defaults to manual if unset ─────────────
# SHIPPING_PROVIDER=manual
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# SHIPPING_WEBHOOK_SECRET=

# ── Analytics (optional — all no-op if unset; safe to omit locally) ───────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_CLARITY_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_ANALYTICS_DEBUG=1       # DebugView testing only

# ── GA4 Data API for /admin analytics (optional; keyless via GCP WIF) ─────────
# Parked until after go-live. See docs/DEPLOYMENT_ENV.md section 5.
# GA4_PROPERTY_ID=
# GA4_API_SECRET=
# GCP_WORKLOAD_IDENTITY_AUDIENCE=
# GA4_SERVICE_ACCOUNT_EMAIL=
