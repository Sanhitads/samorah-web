# Copy to .env.local and fill in. Never commit .env.local.

# ── Supabase (Phase 2+) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudinary (image CDN) ──
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Razorpay (Phase 12) ──
# key_id is public (client opens Checkout with it) → must be NEXT_PUBLIC_.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: our Razorpay account id ("acc_XXXX") → webhook merchant guard.
RAZORPAY_ACCOUNT_ID=

# ── Order persistence (Phase 12/2B) ──
# Secret for the Thank-You capability token (falls back to the Razorpay secret).
ORDER_TOKEN_SECRET=
# Shared secret for the /api/cron/reservations housekeeping endpoint.
CRON_SECRET=

# ── Shiprocket (Phase 13) ──
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# ── Email (Phase 14) — provider-agnostic; Resend implemented today ──
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Sender + reply-to. Defaults to hello@<primary domain> (a personal brand address,
# NOT no-reply). Requires the sending domain to be verified with the provider.
EMAIL_FROM="Samorah <hello@samorahstudio.com>"
EMAIL_REPLY_TO=hello@samorahstudio.com

# ── App ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
