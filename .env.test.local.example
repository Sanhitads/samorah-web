# Copy to .env.test.local to run the *.integration.test.ts suites against LOCAL Supabase.
#
# WHY: vitest runs in test mode and loads `.env.test.local` with HIGHER priority than `.env.local`,
# so these LOCAL values override a hosted `.env.local` for tests only (your `npm run dev` / build keep
# using `.env.local`). The integration-guard (src/test/integration-guard.ts) FAILS CLOSED unless every
# Supabase URL here is local — so tests can never reach a hosted/production database.
#
# `.env.test.local` is gitignored. Fill these from `npm run db:status` after `npm run db:start`.
# NEVER put hosted/production values in this file.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=        # local "Secret" key from `npm run db:status`
NEXT_PUBLIC_SUPABASE_ANON_KEY=    # local "Publishable" key from `npm run db:status`

# The local-only inventory/payment/receiving integration suites also read these (same local values):
INV_TEST_SUPABASE_URL=http://127.0.0.1:54321
INV_TEST_SERVICE_KEY=             # = SUPABASE_SERVICE_ROLE_KEY (local)
INV_TEST_ANON_KEY=                # = NEXT_PUBLIC_SUPABASE_ANON_KEY (local)
