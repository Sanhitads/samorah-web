# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
.next/
out/
build/

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Blanket guard for any *.local env file (e.g. .env.preview.local) — never commit secrets.
# .env.local.example (committed template, no secrets) is NOT matched: it ends in .example.
.env*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.swp

# Deploy / tooling
.vercel
.turbo
*.tsbuildinfo
next-env.d.ts
coverage/
playwright-report/
test-results/

# Supabase local
supabase/.branches
supabase/.temp

# Claude Code (personal/local)
.claude/settings.local.json

# Never commit env backups (they contain secrets)
*.bak
.env*.local.bak

# Dev-server build dir (isolated from production .next)
.next-dev/
